# ==============================================================================
# Wealify Frontend Environment Configuration (.env.example)
# Copy this file to .env.local (or .env) for local development.
# ==============================================================================

# ─── Backend API URL ──────────────────────────────────────────────────────────
# Base URL of the Wealify FastAPI backend service
NEXT_PUBLIC_API_URL="http://localhost:8000"

# ─── Application Branding & Metadata ──────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Wealify"
NEXT_PUBLIC_APP_TAGLINE="AI Financial Guardian"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── Feature Flags & Environments ─────────────────────────────────────────────
# Set to "production" or "development"
NEXT_PUBLIC_ENV="development"
