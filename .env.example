# ==============================================================================
# Wealify Unified Environment Configuration (.env.example)
# Single unified environment file for both Backend (FastAPI) and Frontend (Next.js).
# Copy this file to `.env` in the project root.
# ==============================================================================

# ─── BACKEND: Application & Server Settings ───────────────────────────────────
APP_NAME="Wealify Financial Assistant"
APP_VERSION="0.1.0"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# ─── BACKEND: Database Configuration ──────────────────────────────────────────
# Default: Local SQLite database with async driver (aiosqlite)
DATABASE_URL="sqlite+aiosqlite:///./wealify.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/wealify"

# ─── BACKEND: Security & Authentication (JWT) ─────────────────────────────────
# Secret key used for signing JWT access tokens (minimum 64 characters recommended)
SECRET_KEY="wealify-ai-financial-guardian-secret-key-2026-hackathon-security-token-64bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── SHARED: Google OAuth 2.0 Configuration ───────────────────────────────────
# Client ID created in Google Cloud Console (APIs & Services -> Credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
NEXT_PUBLIC_GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"

# ─── BACKEND: CORS Allowed Origins ────────────────────────────────────────────
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080"

# ─── BACKEND: LLM Provider (On-demand statement analysis) ─────────────────────
# Options: deepseek | anthropic | openai
LLM_PROVIDER="deepseek"
LLM_API_KEY="sk-your-deepseek-api-key-here"
LLM_MODEL="deepseek-chat"

# ─── BACKEND: Email Receipt Matching (Optional IMAP) ──────────────────────────
IMAP_HOST="imap.gmail.com"
IMAP_USER="your-financial-inbox@gmail.com"
IMAP_PASSWORD="your-app-specific-password"

# ─── FRONTEND: Next.js Client Settings ────────────────────────────────────────
# Base URL pointing to the FastAPI backend service
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_APP_NAME="Wealify"
NEXT_PUBLIC_APP_TAGLINE="AI Financial Guardian"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_ENV="development"
