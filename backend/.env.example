# Application
APP_NAME="Wealify Financial Assistant"
DEBUG=true

# Database
DATABASE_URL="sqlite+aiosqlite:///./wealify.db"

# LLM Configuration (TBD - to be decided)
# Options: anthropic, openai, gemini
LLM_PROVIDER=anthropic
LLM_API_KEY=your-api-key-here
LLM_MODEL=claude-3-sonnet-20240229

# Email (IMAP) - Optional
IMAP_HOST=imap.gmail.com
IMAP_USER=your-email@gmail.com
IMAP_PASSWORD=your-app-password

# Security
SECRET_KEY=change-me-in-production-use-a-long-random-string

# ML Inference
# Folder holding trained checkpoints (categorizer.joblib, anomaly_scorer.joblib).
# Defaults to backend/src/modules/ml/artifacts; point it at the repo-root
# ./checkpoints folder to use the shared, deployable location.
# Missing/unreadable checkpoints silently fall back to heuristics —
# verify with: curl -s localhost:8000/api/ml/models | jq
ML_ARTIFACT_DIR=../checkpoints
ML_ENABLED=true

