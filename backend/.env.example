# ==============================================================================
# Wealify Backend Environment Configuration (.env.example)
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# ─── Application Settings ──────────────────────────────────────────────────────
APP_NAME="Wealify Financial Assistant"
APP_VERSION="0.1.0"
DEBUG=true
HOST="127.0.0.1"
PORT=8000

# ─── Database Configuration ────────────────────────────────────────────────────
# Default: Local SQLite database with async driver (aiosqlite)
DATABASE_URL="sqlite+aiosqlite:///./wealify.db"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/wealify"

# ─── Security & Authentication (JWT) ──────────────────────────────────────────
# Secret key used for signing JWT access tokens (minimum 64 characters recommended)
SECRET_KEY="wealify-ai-financial-guardian-secret-key-2026-hackathon-security-token-64bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ─── CORS Allowed Origins ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080"

# ─── LLM Provider (Pluggable on-demand statement analysis) ────────────────────
# Options: anthropic | openai | gemini
LLM_PROVIDER="anthropic"
LLM_API_KEY="your-llm-api-key-here"
LLM_MODEL="claude-3-sonnet-20240229"

# ─── Email Receipt Matching (Optional IMAP) ───────────────────────────────────
# Used for automatic cross-referencing of e-invoices with transactions
IMAP_HOST="imap.gmail.com"
IMAP_USER="your-financial-inbox@gmail.com"
IMAP_PASSWORD="your-app-specific-password"
